generator client {
  provider      = "prisma-client-js"
  // "native" covers local dev outside Docker; linux-musl-openssl-3.0.x covers
  // the node:20-alpine deploy image (Alpine ships OpenSSL 3.x, not 1.1) — without
  // this, Prisma's engine can fail to detect libssl in some container/host
  // combinations and crash with a non-JSON "Error loading..." response.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  staff
}

enum UserStatus {
  active
  inactive
  blocked
}

enum FeatureKey {
  invoices
  timesheet
  clients_crm
  quotes
}

enum QuoteStatus {
  draft
  sent
  approved
  declined
  expired
  scheduled
  completed
}

enum BookingStatus {
  idle
  proposed
  rejected
  confirmed
}

enum DayWindow {
  morning
  afternoon
  fullday
}

enum ScheduleRoundStatus {
  proposed
  rejected
  confirmed
}

enum InvoiceSource {
  quote
  timesheet
}

enum TimesheetEntryStatus {
  open
  invoiced
}

enum ServiceBillingType {
  quantity
  hourly
}

model User {
  id                String   @id @default(uuid())
  name              String
  email             String   @unique
  passwordHash      String
  role              Role     @default(staff)
  status            UserStatus @default(active)
  hourlyRate        Decimal  @db.Decimal(10, 2) @default(0)
  // Default service name for timesheet labor lines on invoices; snapshotted
  // into TimesheetEntry.serviceName at entry creation.
  defaultServiceName String   @default("Labor")
  // Where client-response notifications (quote approved/declined, booking
  // date confirmed/rejected) get sent. Null means "use `email`" — kept
  // separate from the login email so a user can route notifications
  // elsewhere without changing how they sign in.
  notificationEmail String?
  createdAt         DateTime @default(now())
  quotes            Quote[]
  clients           Client[]
  invoices          Invoice[]
  timesheetEntries  TimesheetEntry[]
  featureFlags      UserFeatureFlag[]
  companyProfile    CompanyProfile?
  auditLogTargets   AuditLog[]
  serviceCatalogItems ServiceCatalogItem[]
}

model Client {
  id               String            @id @default(uuid())
  name             String
  email            String
  phone            String?
  address          String?
  // Owner of this client record; the same email may exist per user.
  userId           String
  user             User              @relation(fields: [userId], references: [id])
  quotes           Quote[]
  invoices         Invoice[]
  timesheetEntries TimesheetEntry[]

  @@unique([userId, email])
  @@index([userId])
}

// Per-user products/services a user offers, priced for quick reuse on
// timesheet entries. Adding one here does not touch existing timesheet
// products — TimesheetProduct rows are immutable snapshots, never a live
// relation to this catalog.
model ServiceCatalogItem {
  id           String              @id @default(uuid())
  userId       String
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  defaultPrice Decimal             @db.Decimal(10, 2)
  // quantity = per unit/package; hourly = per hour (unit is always null then,
  // the unit is implicitly "hour"). A fraction of quantity is just a fraction
  // of the package (e.g. 0.5 of a 1kg item = half its price).
  billingType  ServiceBillingType  @default(quantity)
  unit         String?
  createdAt    DateTime            @default(now())

  @@index([userId])
}

model Quote {
  id          String      @id @default(uuid())
  number      Int         @unique @default(autoincrement())
  revision    Int         @default(1)
  status      QuoteStatus @default(draft)
  draftId     String      @unique
  clientId    String
  // Cascade: deleting a Client removes all their quotes (and, transitively,
  // QuoteItems/QuotePhotos/ScheduleRounds via their own Cascade rules) — but
  // NOT their Invoice (Invoice.quote has no cascade, deliberately: an
  // invoice is a frozen record the client already received by email, so
  // deleting one requires an explicit DELETE /api/invoices/[id] first,
  // rather than silently vanishing as a side effect of deleting the client).
  client      Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdById String
  // Owner of the quote (also the invoice owner when this quote is completed).
  // The future Tenant migration will add `tenantId` alongside this owner
  // relation when the SaaS pivot lands.
  createdBy   User        @relation(fields: [createdById], references: [id])
  subtotal    Decimal     @db.Decimal(10, 2) @default(0)
  taxRate     Decimal     @db.Decimal(5, 4) @default(0)
  taxAmount   Decimal     @db.Decimal(10, 2) @default(0)
  total       Decimal     @db.Decimal(10, 2) @default(0)
  publicToken String      @unique @default(uuid())
  // Where the work happens — kept on the Quote, not the Client, since the
  // same client can request quotes for different properties (rental, a
  // second home, a job for someone else's address, etc).
  serviceAddress   String?
  bookingStatus    BookingStatus @default(idle)
  scheduledDate    DateTime?
  scheduledWindow  DayWindow?
  rounds           ScheduleRound[]
  sentAt      DateTime?
  respondedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  items       QuoteItem[]
  invoice     Invoice?

  @@index([createdById])
}

model QuoteItem {
  id          String       @id @default(uuid())
  quoteId     String
  quote       Quote        @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  localItemId String       @unique
  title       String
  description String?
  price       Decimal      @db.Decimal(10, 2)
  sortOrder   Int          @default(0)
  photos      QuotePhoto[]
}

model QuotePhoto {
  id          String    @id @default(uuid())
  quoteItemId String
  quoteItem   QuoteItem @relation(fields: [quoteItemId], references: [id], onDelete: Cascade)
  filePath    String
  sortOrder   Int       @default(0)
}

// Per-user billing/branding profile — shown as the "From" party on the
// client-facing quote/portal page. One profile per user (the fixed-id
// 'company' singleton was replaced by per-user ownership).
model CompanyProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  name      String?
  phone     String?
  email     String?
  address   String?
  logoPath  String?
  updatedAt DateTime @updatedAt
}

// Created once, when staff marks a scheduled job Completed (POST
// /api/quotes/[id]/complete) or generates a timesheet invoice (POST
// /api/timesheet/invoice) — a snapshot of the totals at that moment, not a
// live recompute, so later edits to the source can't silently change an
// invoice the client already received by email.
enum InvoicePaymentStatus {
  pending
  paid
}

model Invoice {
  id            String               @id @default(uuid())
  number        Int                  @unique @default(autoincrement())
  source        InvoiceSource        @default(quote)
  quoteId       String?              @unique
  quote         Quote?               @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  userId        String
  user          User                 @relation(fields: [userId], references: [id])
  clientId      String
  client        Client               @relation(fields: [clientId], references: [id])
  serviceAddress String?
  subtotal      Decimal              @db.Decimal(10, 2)
  taxRate       Decimal              @db.Decimal(5, 4)
  taxAmount     Decimal              @db.Decimal(10, 2)
  total         Decimal              @db.Decimal(10, 2)
  sentAt        DateTime?
  paymentStatus InvoicePaymentStatus @default(pending)
  paidAt        DateTime?
  createdAt     DateTime             @default(now())
  lineItems     InvoiceLineItem[]
  timesheetEntries TimesheetEntry[]

  @@index([userId])
  @@index([clientId])
}

model InvoiceLineItem {
  id            String   @id @default(uuid())
  invoiceId     String
  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  sourceEntryId String?
  description   String
  notes         String?
  quantity      Decimal  @db.Decimal(10, 3)
  unitPrice     Decimal  @db.Decimal(10, 2)
  amount        Decimal  @db.Decimal(10, 2)
  sortOrder     Int      @default(0)
}

model TimesheetEntry {
  id              String               @id @default(uuid())
  userId          String
  user            User                 @relation(fields: [userId], references: [id])
  clientId        String
  client          Client               @relation(fields: [clientId], references: [id])
  workDate        DateTime             @db.Date
  startedAt       DateTime
  endedAt         DateTime
  durationMinutes Int
  hourlyRate      Decimal              @db.Decimal(10, 2)
  // Snapshot of User.defaultServiceName at creation — never rewritten, same
  // rule as hourlyRate.
  serviceName     String               @default("Labor")
  description     String
  status          TimesheetEntryStatus @default(open)
  invoiceId       String?
  invoice         Invoice?             @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  products        TimesheetProduct[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([userId, workDate])
  @@index([clientId, workDate])
  @@index([invoiceId])
}

model TimesheetProduct {
  id               String         @id @default(uuid())
  timesheetEntryId String
  timesheetEntry   TimesheetEntry @relation(fields: [timesheetEntryId], references: [id], onDelete: Cascade)
  name             String
  quantity         Decimal        @db.Decimal(10, 3)
  unitPrice        Decimal        @db.Decimal(10, 2)
  lineTotal        Decimal        @db.Decimal(10, 2)
}

model UserFeatureFlag {
  id      String     @id @default(uuid())
  userId  String
  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature FeatureKey
  enabled Boolean    @default(false)

  @@unique([userId, feature])
  @@index([userId])
}

model AuditLog {
  id           String   @id @default(uuid())
  entityType   String
  entityId     String
  action       String
  actorId      String?
  targetUserId String?
  targetUser   User?    @relation(fields: [targetUserId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@index([actorId])
  @@index([targetUserId])
  @@index([createdAt])
}

model ScheduleRound {
  id              String              @id @default(uuid())
  quoteId         String
  quote           Quote               @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  roundNumber     Int
  status          ScheduleRoundStatus @default(proposed)
  rejectionReason String?
  proposedAt      DateTime            @default(now())
  respondedAt     DateTime?
  options         ScheduleOption[]

  @@unique([quoteId, roundNumber])
}

model ScheduleOption {
  id           String         @id @default(uuid())
  roundId      String
  round        ScheduleRound  @relation(fields: [roundId], references: [id], onDelete: Cascade)
  proposedDate DateTime       @db.Date
  window       DayWindow
  chosen       Boolean        @default(false)

  @@unique([roundId, proposedDate, window])
}